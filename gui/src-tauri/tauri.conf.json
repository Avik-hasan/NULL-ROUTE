{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CustomVPN",
  "version": "2.0.0",
  "identifier": "dev.customvpn.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "NULL ROUTE // OBLIVION PROTOCOL",
        "width": 1100,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}
